# 应用配置
APP_NAME=Session Memory
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/session_memory
POSTGRES_PASSWORD=your_password_here
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=3600

# 嵌入模型配置（使用本地模型，无需API Key）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# 摘要功能（可选，默认禁用）
ENABLE_AUTO_SUMMARY=true
SUMMARY_TRIGGER_COUNT=3

# 上下文管理
MAX_CONTEXT_TOKENS=8000
RECENT_MESSAGES_COUNT=10
MAX_RETRIEVED_MESSAGES=3

# Grafana
GRAFANA_PASSWORD=your_password_here

# LLM API 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.edgefn.net/v1
OPENAI_MODEL=DeepSeek-V3.2-EXP
SUMMARY_MODEL=DeepSeek-V3.2-EXP
BACKUP_OPENAI_API_KEY=sk-your-backup-api-key-here
BACKUP_OPENAI_BASE_URL=https://api.edgefn.net/v1
BACKUP_OPENAI_MODEL=DeepSeek-R1-0528-Qwen3-8B
BACKUP_SUMMARY_MODEL=DeepSeek-R1-0528-Qwen3-8B
LLM_ROUTING_MODE=load_balance
