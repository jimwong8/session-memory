--- src/main.py
+++ src/main.py
@@ -19,6 +19,30 @@
 from src.config import settings
 from src.utils import setup_logging
 
+
+@app.get("/api/v1/stats")
+async def system_stats():
+    """Ultra-fast system stats"""
+    from src.database import async_session
+    from sqlalchemy import text
+    async with async_session() as db:
+        msgs = (await db.execute(text("SELECT count(*) FROM messages"))).scalar() or 0
+        sessions = (await db.execute(text("SELECT count(*) FROM sessions"))).scalar() or 0
+        entities = (await db.execute(text("SELECT count(*) FROM kg_entities"))).scalar() or 0
+        relations = (await db.execute(text("SELECT count(*) FROM kg_relations"))).scalar() or 0
+        atoms = (await db.execute(text("SELECT count(*) FROM memory_atoms"))).scalar() or 0
+        scenarios = (await db.execute(text("SELECT count(*) FROM memory_scenarios"))).scalar() or 0
+        bge = (await db.execute(text("SELECT count(*) FROM messages WHERE embedding IS NOT NULL"))).scalar() or 0
+        m3 = (await db.execute(text("SELECT count(*) FROM messages WHERE embedding_m3 IS NOT NULL"))).scalar() or 0
+        kg_done = (await db.execute(text("SELECT count(*) FROM messages WHERE metadata_json->>'kg_extract_pending'='false' AND metadata_json->>'kg_extract_status' in ('done','done_local') AND length(content)>=50"))).scalar() or 0
+        kg_pending = (await db.execute(text("SELECT count(*) FROM messages WHERE metadata_json->>'kg_extract_pending'='true' AND length(content)>=50"))).scalar() or 0
+    return {
+        "messages": msgs, "sessions": sessions, "entities": entities, "relations": relations,
+        "atoms": atoms, "scenarios": scenarios, "bge": bge, "m3": m3,
+        "bge_pct": round(bge/max(msgs,1)*100,1), "m3_pct": round(m3/max(msgs,1)*100,1),
+        "kg_done": kg_done, "kg_pending": kg_pending,
+    }
+
 app = FastAPI(title="Session Memory API")
 
 
